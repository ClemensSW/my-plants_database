{
  "name": "my-plants-database",
  "version": "1.0.0",
  "description": "Datenbeschaffung und -aufbereitung für die My-Plants Lern-App",
  "main": "index.js",
  "scripts": {
    "fetch-keys": "node legacy/01_fetch_taxonkeys.js",
    "enrich-species": "node legacy/02_enrich_species.js",
    "enrich-wikidata": "node legacy/03_enrich_wikidata.js",
    "filter-species": "node legacy/04_filter_species.js",
    "collect-multimedia": "node legacy/05_collect_multimedia.js",
    "retry-multimedia": "node legacy/05b_retry_multimedia.js",
    "pipeline:species": "node pipeline/01_fetch_species.js",
    "pipeline:names": "node pipeline/02_fetch_plantnet_names.js",
    "pipeline:merge": "node pipeline/03_merge_names.js",
    "pipeline:images": "node pipeline/04_fetch_plantnet_images.js",
    "pipeline:families": "node pipeline/05_fetch_family_names.js",
    "pipeline:ecology": "node pipeline/06_build_ecology.js",
    "pipeline:build": "node pipeline/07_build_documents.js",
    "test:aufloeser": "node pipeline/tests/gbif-key-resolver_test.js",
    "test:namen": "node pipeline/tests/botanical-name_test.js",
    "test:suchindex": "node pipeline/tests/search-normalize_test.js",
    "pruefe:soll": "node pipeline/tests/sollrechnung.js",
    "pipeline:all": "npm run pipeline:species && npm run pipeline:names && npm run pipeline:merge && npm run pipeline:images && npm run pipeline:families && npm run pipeline:ecology && npm run pipeline:build",
    "build-exam-lists": "node legacy/build-exam-lists.js",
    "validate-exam-lists": "node legacy/validate-exam-lists.js",
    "build-all": "npm run fetch-keys && npm run enrich-species && npm run enrich-wikidata && npm run filter-species && npm run collect-multimedia",
    "build-species": "npm run fetch-keys && npm run enrich-species && npm run enrich-wikidata && npm run filter-species",
    "test:fetch": "node legacy/tests/01_fetch_taxonkeys_test.js",
    "test:enrich": "node legacy/tests/02_enrich_species_test.js",
    "test:wikidata": "node legacy/tests/03_enrich_wikidata_test.js",
    "test:filter": "node legacy/tests/04_filter_species_test.js",
    "test:multimedia": "node legacy/tests/05_collect_multimedia_test.js",
    "test:all": "npm run test:fetch && npm run test:enrich && npm run test:wikidata && npm run test:filter && npm run test:multimedia",
    "test": "npm run test:all",
    "pipeline:sorten": "node pipeline/10_fetch_wikidata_cultivars.js",
    "pipeline:commons": "node pipeline/11_fetch_commons_images.js",
    "test:organ": "node pipeline/tests/organ-aus-dateiname_test.js"
  },
  "keywords": [
    "gbif",
    "plants",
    "taxonomy",
    "database",
    "my-plants"
  ],
  "author": "My-Plants Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/my-plants-database.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "p-limit": "^3.1.0"
  }
}
