{
  "name": "my-plants-database",
  "version": "1.0.0",
  "description": "Datenbeschaffung und -aufbereitung für die My-Plants Lern-App",
  "main": "index.js",
  "scripts": {
    "fetch-keys": "node scripts/01_fetch_taxonkeys.js",
    "enrich-species": "node scripts/02_enrich_species.js",
    "enrich-wikidata": "node scripts/03_enrich_wikidata.js",
    "filter-species": "node scripts/04_filter_species.js",
    "collect-multimedia": "node scripts/05_collect_multimedia.js",
    "retry-multimedia": "node scripts/05b_retry_multimedia.js",
    "build-exam-lists": "node scripts/build-exam-lists.js",
    "validate-exam-lists": "node scripts/validate-exam-lists.js",
    "build-all": "npm run fetch-keys && npm run enrich-species && npm run enrich-wikidata && npm run filter-species && npm run collect-multimedia",
    "build-species": "npm run fetch-keys && npm run enrich-species && npm run enrich-wikidata && npm run filter-species",
    "test:fetch": "node scripts/tests/01_fetch_taxonkeys_test.js",
    "test:enrich": "node scripts/tests/02_enrich_species_test.js",
    "test:wikidata": "node scripts/tests/03_enrich_wikidata_test.js",
    "test:filter": "node scripts/tests/04_filter_species_test.js",
    "test:multimedia": "node scripts/tests/05_collect_multimedia_test.js",
    "test:all": "npm run test:fetch && npm run test:enrich && npm run test:wikidata && npm run test:filter && npm run test:multimedia",
    "test": "npm run test:all"
  },
  "keywords": [
    "gbif",
    "plants",
    "taxonomy",
    "database",
    "my-plants"
  ],
  "author": "My-Plants Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/my-plants-database.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "p-limit": "^3.1.0"
  }
}
